# Kalshi API — copy to .env and fill in. .env is gitignored.
# Requires: pip install "kyro[auth]"

# Auth (required for orders, portfolio, live smoke)
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=/path/to/your.pem
# or inline PEM (use \n for newlines):
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Environment (optional)
# KALSHI_DEMO=1
# KALSHI_PRODUCTION=1
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2

# Live smoke audit log path (optional)
# KALSHI_SMOKE_AUDIT_LOG=live_smoke_audit.log
